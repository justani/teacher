# Created automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Set these in both the Convex development environment and the Next.js server
# environment. Never prefix them with NEXT_PUBLIC_.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLIENT_EMAIL=service-account@your-google-cloud-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GEMINI_TEXT_MODEL=gemini-3.7-flash
SARVAM_API_KEY=your-sarvam-api-key

# Used only by the local drawing playground at /drawing-playground.
OPENAI_API_KEY=your-openai-api-key
# Set true only when intentionally running the playground with NODE_ENV=production.
DRAWING_PLAYGROUND_ENABLED=false

# Used only by the Next.js streamed TTS relay.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
